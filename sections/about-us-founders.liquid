{%- liquid
  assign about_heading_font = settings.font_heading | font_modify: 'weight', 'bold'
-%}

<section
  class="about-founders"
  data-section-id="{{ section.id }}"
  data-section-type="about-us-founders"
>
  <div class="about-founders__inner">
    <div class="about-founders__intro">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="about-founders__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="about-founders__body rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    <div class="about-founders__people">
      {%- for block in section.blocks -%}
        <article class="about-founders__person" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 1000 }}"
              srcset="
                {{ block.settings.image | image_url: width: 450 }} 450w,
                {{ block.settings.image | image_url: width: 700 }} 700w,
                {{ block.settings.image | image_url: width: 1000 }} 1000w
              "
              sizes="(min-width: 48em) 32vw, 100vw"
              alt="{{ block.settings.image.alt | default: block.settings.name | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="about-founders__placeholder">Founder image</div>
          {%- endif -%}

          {%- if block.settings.name != blank or block.settings.text != blank -%}
            <div class="about-founders__caption">
              {%- if block.settings.name != blank -%}
                <h3>{{ block.settings.name }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="about-founders__caption-text rte">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  {{ about_heading_font | font_face: font_display: 'swap' }}

  .about-founders {
    color: #ffffff;
    background: #0f0f0f;
  }

  .about-founders__inner {
    display: grid;
    grid-template-columns: minmax(280px, 0.76fr) minmax(0, 1.24fr);
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(48px, 5vw, 76px) var(--space-outer);
    box-sizing: border-box;
  }

  .about-founders__intro {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding-right: clamp(36px, 5vw, 80px);
  }

  .about-founders__intro h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(42px, 4.5vw, 68px);
    font-style: normal;
    font-weight: {{ about_heading_font.weight | default: 700 }};
    line-height: 0.92;
    letter-spacing: var(--font-heading-base-letter-spacing);
    text-transform: uppercase;
  }

  .about-founders__subheading {
    margin: var(--spacing-medium) 0 0;
    font-family: var(--font-heading);
    font-size: clamp(20px, 1.8vw, 28px);
    font-style: normal;
    font-weight: {{ about_heading_font.weight | default: 700 }};
    line-height: 1;
    letter-spacing: var(--font-heading-base-letter-spacing);
    text-transform: uppercase;
  }

  .about-founders__body {
    max-width: 480px;
    margin-top: clamp(32px, 4vw, 56px);
    font-family: var(--font-body);
    font-size: 16px;
    font-style: normal;
    font-weight: var(--font-body-weight);
    line-height: 1.25;
  }

  .about-founders__body p {
    margin: 0;
  }

  .about-founders__body p + p {
    margin-top: var(--spacing-medium);
  }

  .about-founders__people {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-width: 0;
  }

  .about-founders__person {
    position: relative;
    min-width: 0;
    min-height: 520px;
    overflow: hidden;
    background: #1b1b1b;
  }

  .about-founders__person img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-founders__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 520px;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: var(--font-body-weight);
    text-transform: uppercase;
    opacity: 0.55;
  }

  .about-founders__caption {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    padding: 16px 18px;
    color: #ffffff;
    background: rgba(15, 15, 15, 0.82);
  }

  .about-founders__caption h3 {
    margin: 0 0 6px;
    font-family: var(--font-heading);
    font-size: 20px;
    font-style: normal;
    font-weight: {{ about_heading_font.weight | default: 700 }};
    line-height: 1;
    letter-spacing: var(--font-heading-base-letter-spacing);
    text-transform: uppercase;
  }

  .about-founders__caption-text {
    font-family: var(--font-body);
    font-size: 13px;
    font-style: normal;
    font-weight: var(--font-body-weight);
    line-height: 1.3;
  }

  .about-founders__caption-text p {
    margin: 0;
  }

  @media screen and (max-width: 64em) {
    .about-founders__inner {
      grid-template-columns: 1fr;
      gap: var(--spacing-extra-large);
    }

    .about-founders__intro {
      padding-right: 0;
    }

    .about-founders__body {
      max-width: 680px;
    }
  }

  @media screen and (max-width: 42em) {
    .about-founders__people {
      grid-template-columns: 1fr;
      gap: var(--spacing-medium);
    }

    .about-founders__person,
    .about-founders__placeholder {
      min-height: 440px;
    }

    .about-founders__intro h2 {
      font-size: 44px;
    }

    .about-founders__caption {
      right: 12px;
      bottom: 12px;
      left: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "About Us founders",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The founders"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Every decision, together."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>EZENTI is built through constant collaboration.</p><p>Every collection moves back and forth between creative exploration and strategic refinement until every decision feels intentional.</p><p>That dialogue shapes everything we create.</p>"
    }
  ],
  "blocks": [
    {
      "type": "founder",
      "name": "Founder",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name or title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Add the founder description here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us founders",
      "blocks": [
        {
          "type": "founder"
        },
        {
          "type": "founder"
        }
      ]
    }
  ]
}
{% endschema %}
