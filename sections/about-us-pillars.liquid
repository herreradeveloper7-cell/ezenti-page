{%- liquid
  assign about_heading_font = settings.font_heading | font_modify: 'weight', 'bold'
-%}

<section
  class="about-pillars"
  data-section-id="{{ section.id }}"
  data-section-type="about-us-pillars"
>
  <div class="about-pillars__inner">
    <div class="about-pillars__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1100 }}"
          srcset="
            {{ section.settings.image | image_url: width: 500 }} 500w,
            {{ section.settings.image | image_url: width: 750 }} 750w,
            {{ section.settings.image | image_url: width: 1100 }} 1100w
          "
          sizes="(min-width: 60em) 32vw, 100vw"
          alt="{{ section.settings.image.alt | default: page.title | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="about-pillars__placeholder">About Us image</div>
      {%- endif -%}
    </div>

    <div class="about-pillars__grid">
      {%- for block in section.blocks -%}
        <article class="about-pillars__item" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2>{{ block.settings.heading }}</h2>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="about-pillars__text rte">
              {{ block.settings.text }}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  {{ about_heading_font | font_face: font_display: 'swap' }}

  .about-pillars {
    color: #ffffff;
    background: #0f0f0f;
  }

  .about-pillars__inner {
    display: grid;
    grid-template-columns: minmax(280px, 0.88fr) minmax(0, 2.12fr);
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(48px, 5vw, 76px) var(--space-outer);
    box-sizing: border-box;
  }

  .about-pillars__media {
    min-height: 500px;
    overflow: hidden;
    background: #1b1b1b;
  }

  .about-pillars__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-pillars__placeholder {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 500px;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: var(--font-body-weight);
    text-transform: uppercase;
    opacity: 0.55;
  }

  .about-pillars__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-content: center;
    padding: 0 0 0 clamp(28px, 3.5vw, 56px);
  }

  .about-pillars__item {
    min-width: 0;
    padding: 0 clamp(24px, 2.5vw, 42px);
  }

  .about-pillars__item:first-child {
    padding-left: 0;
  }

  .about-pillars__item + .about-pillars__item {
    border-left: 1px solid rgba(255, 255, 255, 0.68);
  }

  .about-pillars__item h2 {
    margin: 0 0 var(--spacing-large);
    font-family: var(--font-heading);
    font-size: clamp(28px, 2.2vw, 38px);
    font-style: normal;
    font-weight: {{ about_heading_font.weight | default: 700 }};
    line-height: 0.95;
    letter-spacing: var(--font-heading-base-letter-spacing);
    text-transform: uppercase;
  }

  .about-pillars__text {
    font-family: var(--font-body);
    font-size: 15px;
    font-style: normal;
    font-weight: var(--font-body-weight);
    line-height: 1.25;
  }

  .about-pillars__text p {
    margin: 0;
  }

  .about-pillars__text p + p {
    margin-top: var(--spacing-medium);
  }

  @media screen and (max-width: 70em) {
    .about-pillars__inner {
      grid-template-columns: minmax(240px, 0.72fr) minmax(0, 1.28fr);
    }

    .about-pillars__grid {
      grid-template-columns: 1fr;
      align-content: stretch;
      padding-left: var(--spacing-extra-large);
    }

    .about-pillars__item,
    .about-pillars__item:first-child {
      padding: var(--spacing-extra-large) 0;
    }

    .about-pillars__item:first-child {
      padding-top: 0;
    }

    .about-pillars__item:last-child {
      padding-bottom: 0;
    }

    .about-pillars__item + .about-pillars__item {
      border-top: 1px solid rgba(255, 255, 255, 0.68);
      border-left: 0;
    }
  }

  @media screen and (max-width: 48em) {
    .about-pillars__inner {
      grid-template-columns: 1fr;
      gap: var(--spacing-extra-large);
      padding-top: var(--spacing-extra-large);
      padding-bottom: var(--spacing-extra-large);
    }

    .about-pillars__media,
    .about-pillars__placeholder {
      min-height: 420px;
    }

    .about-pillars__grid {
      padding-left: 0;
    }

    .about-pillars__item h2 {
      font-size: 30px;
    }
  }

  @media screen and (max-width: 38em) {
    .about-pillars__media,
    .about-pillars__placeholder {
      min-height: 340px;
    }

    .about-pillars__text {
      font-size: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "About Us pillars",
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "What we're building"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add the column content here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us pillars",
      "blocks": [
        {
          "type": "pillar"
        },
        {
          "type": "pillar"
        },
        {
          "type": "pillar"
        }
      ]
    }
  ]
}
{% endschema %}
