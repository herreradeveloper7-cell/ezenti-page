{%- liquid
  assign collector_collection = section.settings.collection
  assign max_products = section.settings.max_products
  assign visible_product_count = 4
  assign collector_heading_font = settings.font_heading | font_modify: 'weight', 'bold'

  if collector_collection != blank and collector_collection.products_count > 0
    assign visible_product_count = collector_collection.products_count | at_most: max_products
  endif
-%}

<section
  class="collector-page"
  data-section-id="{{ section.id }}"
  data-section-type="collector-edition"
>
  <div class="collector-page__hero">
    <div class="collector-page__hero-copy">
      <p class="collector-page__eyebrow">{{ section.settings.hero_eyebrow }}</p>
      <h1>{{ section.settings.hero_heading | newline_to_br }}</h1>
    </div>

    <div class="collector-page__hero-media">
      {%- if section.settings.hero_image != blank -%}
        <img
          src="{{ section.settings.hero_image | image_url: width: 1400 }}"
          alt="{{ section.settings.hero_image.alt | escape }}"
          width="{{ section.settings.hero_image.width }}"
          height="{{ section.settings.hero_image.height }}"
          loading="eager"
        >
      {%- else -%}
        <div class="collector-page__image-placeholder">
          Hero image
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="collector-page__release" id="collector-current-release">
    <div class="collector-page__release-header">
      <h2>{{ section.settings.products_heading }}</h2>
    </div>

    <div
      class="collector-page__products"
      style="--collector-product-columns: {{ visible_product_count }};"
    >
        {%- if collector_collection != blank and collector_collection.products_count > 0 -%}
          {%- for product in collector_collection.products limit: max_products -%}
            <article class="collector-product-card">
              <a class="collector-product-card__media" href="{{ product.url | within: collector_collection }}" aria-label="{{ product.title }}">
                {%- if product.featured_media != blank -%}
                  <img
                    src="{{ product.featured_media.preview_image | image_url: width: 700 }}"
                    alt="{{ product.featured_media.alt | default: product.title | escape }}"
                    width="{{ product.featured_media.preview_image.width }}"
                    height="{{ product.featured_media.preview_image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="collector-page__image-placeholder">Product image</div>
                {%- endif -%}
              </a>

              <div class="collector-product-card__meta">
                <h3>
                  <a href="{{ product.url | within: collector_collection }}">{{ product.title }}</a>
                </h3>
                <p>{{ product.price | money }}</p>
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <article class="collector-product-card">
              <div class="collector-product-card__media">
                <div class="collector-page__image-placeholder">Collector product</div>
              </div>
              <div class="collector-product-card__meta">
                <h3>Collector piece</h3>
                <p>$00.00</p>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
    </div>
  </div>

  <div class="collector-page__cta">
    <p>{{ section.settings.cta_eyebrow }}</p>
    <h2>{{ section.settings.cta_heading }}</h2>
    <a
      class="collector-page__cta-scroll"
      href="#collector-story"
      aria-label="Scroll to {{ section.settings.story_heading | escape }}"
      data-collector-scroll
    >
      <span class="collector-page__down-icon" aria-hidden="true"></span>
    </a>
  </div>

  <div class="collector-page__story" id="collector-story">
    <div class="collector-page__story-copy">
      <h2>{{ section.settings.story_heading | newline_to_br }}</h2>
      <div class="collector-page__rte">{{ section.settings.story_text }}</div>
    </div>

    <div class="collector-page__story-media">
      {%- if section.settings.story_image != blank -%}
        <img
          src="{{ section.settings.story_image | image_url: width: 1400 }}"
          alt="{{ section.settings.story_image.alt | escape }}"
          width="{{ section.settings.story_image.width }}"
          height="{{ section.settings.story_image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="collector-page__image-placeholder">
          Story image
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="collector-page__info-grid">
    <div class="collector-page__rules">
      <h2>{{ section.settings.rules_heading }}</h2>
      <ol>
        {%- assign rule_number = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'rule' -%}
            {%- assign rule_number = rule_number | plus: 1 -%}
            <li {{ block.shopify_attributes }}>
              <span>{{ rule_number | prepend: '0' | slice: -2, 2 }}</span>
              <p>{{ block.settings.text }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>

    <div class="collector-page__perspective">
      <h2>{{ section.settings.perspective_heading }}</h2>
      <div class="collector-page__perspective-text">
        {{ section.settings.perspective_text }}
      </div>
    </div>
  </div>

  <div class="collector-page__archive">
    <h2>{{ section.settings.archive_heading }}</h2>
    <div class="collector-page__archive-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'archive_piece' -%}
          <article class="collector-page__archive-card" {{ block.shopify_attributes }}>
            <div class="collector-page__archive-media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 700 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="collector-page__image-placeholder">Archive image</div>
              {%- endif -%}
            </div>
            <p>{{ block.settings.number }}</p>
            <h3>{{ block.settings.title }}</h3>
            <span>{{ block.settings.status }}</span>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="collector-page__timeline" aria-label="{{ section.settings.timeline_year }} Collector Edition timeline">
      <div class="collector-page__timeline-inner">
        <div class="collector-page__timeline-line" aria-hidden="true"></div>

        <div class="collector-page__timeline-point collector-page__timeline-point--year">
          <span>{{ section.settings.timeline_year }}</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="collector-page__timeline-point collector-page__timeline-point--1">
          <span>{{ section.settings.timeline_point_1 }}</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="collector-page__timeline-point collector-page__timeline-point--2">
          <span>{{ section.settings.timeline_point_2 }}</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="collector-page__timeline-point collector-page__timeline-point--3">
          <span>{{ section.settings.timeline_point_3 }}</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="collector-page__timeline-point collector-page__timeline-point--4">
          <span>{{ section.settings.timeline_point_4 }}</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="collector-page__timeline-point collector-page__timeline-point--5">
          <span>{{ section.settings.timeline_point_5 }}</span>
          <i aria-hidden="true"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="collector-page__final">
    <div class="collector-page__final-copy">
      <h2>{{ section.settings.final_heading | newline_to_br }}</h2>
    </div>
    {%- if section.settings.final_image != blank -%}
      <img
        src="{{ section.settings.final_image | image_url: width: 1400 }}"
        alt="{{ section.settings.final_image.alt | escape }}"
        width="{{ section.settings.final_image.width }}"
        height="{{ section.settings.final_image.height }}"
        loading="lazy"
      >
    {%- else -%}
      <div class="collector-page__image-placeholder">Final image</div>
    {%- endif -%}
  </div>
</section>

<style>
  {{ collector_heading_font | font_face: font_display: 'swap' }}

  .collector-page {
    --collector-content-gutter: max(
      var(--space-outer),
      calc((100vw - var(--max-width)) / 2 + var(--space-outer))
    );

    color: var(--color-text);
    background: var(--color-background);
  }

  .collector-page a {
    color: inherit;
  }

  .collector-page__hero,
  .collector-page__story,
  .collector-page__info-grid {
    display: grid;
    grid-template-columns: 0.82fr 1fr;
  }

  .collector-page__hero {
    grid-template-columns: minmax(0, 46%) minmax(0, 54%);
    min-height: clamp(360px, 36vw, 560px);
    color: #fff;
    background: #000;
    border-bottom: 0;
  }

  .collector-page__hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(48px, 7vw, 96px) clamp(24px, 4vw, 60px);
    padding-left: var(--collector-content-gutter);
  }

  .collector-page__story-copy,
  .collector-page__rules,
  .collector-page__perspective {
    padding: clamp(42px, 7vw, 86px) clamp(24px, 4vw, 60px);
  }

  .collector-page__story-copy,
  .collector-page__rules {
    padding-left: var(--collector-content-gutter);
  }

  .collector-page__perspective {
    padding-right: var(--collector-content-gutter);
  }

  .collector-page__eyebrow,
  .collector-page__cta p,
  .collector-page__archive-card p,
  .collector-page__archive-card span {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .collector-page__eyebrow {
    margin: 0 0 10px;
    color: inherit;
    font-family: var(--font-body);
    font-weight: 300;
    letter-spacing: 0;
  }

  .collector-page__hero h1 {
    max-width: 620px;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(36px, 4.2vw, 64px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .collector-page__hero-media {
    min-height: clamp(360px, 36vw, 560px);
    background: #111;
    overflow: hidden;
  }

  .collector-page__story-media,
  .collector-page__final {
    min-height: 420px;
    background: #111;
    overflow: hidden;
  }

  .collector-page__hero-media img,
  .collector-page__story-media img,
  .collector-page__final img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collector-page__image-placeholder {
    display: flex;
    width: 100%;
    min-height: inherit;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: linear-gradient(135deg, #1b1b1b, #3f3f3f);
  }

  .collector-page__down-icon {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
  }

  .collector-page__release {
    padding: clamp(36px, 5vw, 64px) var(--collector-content-gutter) clamp(48px, 6vw, 80px);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .collector-page__release-header {
    margin-bottom: clamp(22px, 3vw, 36px);
  }

  .collector-page h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(24px, 2.2vw, 34px);
    font-style: normal;
    font-weight: {{ collector_heading_font.weight | default: 700 }};
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .collector-page__release-header h2 {
    font-family: var(--font-heading);
    font-style: normal;
    font-weight: {{ collector_heading_font.weight | default: 700 }};
    letter-spacing: var(--font-heading-base-letter-spacing);
  }

  .collector-page__products {
    display: grid;
    grid-template-columns: repeat(var(--collector-product-columns, 4), minmax(0, 1fr));
    column-gap: clamp(18px, 2.5vw, 36px);
    row-gap: var(--spacing-extra-large);
  }

  .collector-product-card {
    min-width: 0;
  }

  .collector-product-card__media {
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--color-card-background);
    overflow: hidden;
  }

  .collector-product-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collector-product-card__meta {
    padding: clamp(16px, 2vw, 24px) 8px 0;
    text-align: center;
  }

  .collector-product-card__meta h3,
  .collector-product-card__meta p {
    margin: 0;
    line-height: 1.35;
  }

  .collector-product-card__meta h3 {
    font-family: var(--font-heading);
    font-size: clamp(14px, 1.25vw, 18px);
    font-weight: 700;
    text-transform: uppercase;
  }

  .collector-product-card__meta h3 a {
    text-decoration: none;
  }

  .collector-product-card__meta p {
    margin-top: 2px;
    font-family: var(--font-body);
    font-size: clamp(13px, 1.1vw, 16px);
    font-weight: 300;
  }

  .collector-page__cta {
    display: flex;
    min-height: 104px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 12px 24px 14px;
    color: #fff;
    text-align: center;
    background: #000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
  }

  .collector-page__cta p {
    margin: 0;
    font-family: var(--font-body);
    font-size: 12px;
    font-style: normal;
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .collector-page__cta h2 {
    margin-top: 2px;
    font-family: var(--font-heading);
    font-size: clamp(25px, 2.35vw, 34px);
    font-style: normal;
    font-weight: {{ collector_heading_font.weight | default: 700 }};
    line-height: 1;
    letter-spacing: var(--font-heading-base-letter-spacing);
  }

  .collector-page__cta-scroll {
    display: inline-flex;
    width: 32px;
    height: 24px;
    align-items: center;
    justify-content: center;
    margin-top: 2px;
    color: inherit;
    text-decoration: none;
  }

  .collector-page__cta-scroll:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 2px;
  }

  .collector-page__cta .collector-page__down-icon {
    width: 9px;
    height: 9px;
    margin-top: -4px;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .collector-page__story {
    grid-template-columns: minmax(0, 43%) minmax(0, 57%);
    scroll-margin-top: var(--header-height, 0px);
  }

  .collector-page__story-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(420px, 38vw, 600px);
  }

  .collector-page__story-copy h2 {
    max-width: 560px;
    font-family: var(--font-heading);
    font-size: clamp(30px, 3vw, 46px);
    font-style: normal;
    font-weight: {{ collector_heading_font.weight | default: 700 }};
    line-height: 1;
    letter-spacing: var(--font-heading-base-letter-spacing);
  }

  .collector-page__rte {
    max-width: 560px;
    margin-top: clamp(24px, 3vw, 36px);
    font-family: var(--font-body);
    font-size: clamp(15px, 1.3vw, 18px);
    font-style: normal;
    font-weight: 300;
    line-height: 1.22;
  }

  .collector-page__rte p {
    margin: 0;
  }

  .collector-page__rte p + p {
    margin-top: 16px;
  }

  .collector-page__info-grid {
    position: relative;
    grid-template-columns: minmax(0, 43%) minmax(0, 57%);
  }

  .collector-page__info-grid::after {
    content: "";
    position: absolute;
    top: clamp(36px, 5vw, 60px);
    bottom: clamp(36px, 5vw, 60px);
    left: 43%;
    width: 1px;
    background: var(--color-border);
    transform: translateX(-0.5px);
  }

  .collector-page__rules,
  .collector-page__perspective {
    min-height: clamp(330px, 28vw, 440px);
  }

  .collector-page__rules {
    position: relative;
  }

  .collector-page__rules h2,
  .collector-page__perspective h2 {
    font-family: var(--font-heading);
    font-style: normal;
    font-weight: {{ collector_heading_font.weight | default: 700 }};
    letter-spacing: var(--font-heading-base-letter-spacing);
  }

  .collector-page__rules ol {
    padding: 0;
    margin: clamp(24px, 3vw, 34px) 0 0;
    list-style: none;
  }

  .collector-page__rules li {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 8px;
    align-items: start;
    margin-bottom: 16px;
  }

  .collector-page__rules li span {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 16px;
    font-style: normal;
    font-weight: {{ collector_heading_font.weight | default: 700 }};
    line-height: 1.15;
    text-transform: uppercase;
  }

  .collector-page__rules li p {
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(14px, 1.15vw, 16px);
    font-style: normal;
    font-weight: 300;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .collector-page__perspective-text {
    max-width: 680px;
    margin-top: clamp(24px, 3vw, 34px);
    font-family: var(--font-body);
    font-size: clamp(15px, 1.3vw, 18px);
    font-style: normal;
    font-weight: 300;
    line-height: 1.12;
  }

  .collector-page__perspective-text p {
    margin: 0;
  }

  .collector-page__perspective-text p + p {
    margin-top: 18px;
  }

  .collector-page__archive {
    padding: 30px var(--collector-content-gutter) 42px;
    border-bottom: 1px solid var(--color-border);
  }

  .collector-page__archive > h2 {
    font-family: var(--font-heading);
    font-style: normal;
    font-weight: {{ collector_heading_font.weight | default: 700 }};
    letter-spacing: var(--font-heading-base-letter-spacing);
  }

  .collector-page__archive-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
    margin-top: 22px;
  }

  .collector-page__archive-media {
    aspect-ratio: 2.4 / 1;
    background: #222;
    overflow: hidden;
  }

  .collector-page__archive-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collector-page__archive-card h3 {
    margin: 4px 0;
    font-family: var(--font-heading);
    font-size: 13px;
    font-style: normal;
    font-weight: {{ collector_heading_font.weight | default: 700 }};
    line-height: 1.15;
    text-transform: uppercase;
  }

  .collector-page__archive-card p {
    margin: 8px 0 0;
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 300;
    letter-spacing: 0;
  }

  .collector-page__archive-card span {
    display: block;
    font-family: var(--font-heading);
    font-style: normal;
    font-weight: {{ collector_heading_font.weight | default: 700 }};
    letter-spacing: var(--font-heading-base-letter-spacing);
  }

  .collector-page__timeline {
    width: 100%;
    margin-top: var(--spacing-extra-large);
    padding: 0 8px var(--spacing-small);
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .collector-page__timeline-inner {
    position: relative;
    min-width: 760px;
    height: 58px;
  }

  .collector-page__timeline-line {
    position: absolute;
    top: 37px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--color-border);
  }

  .collector-page__timeline-line::after {
    content: "";
    position: absolute;
    top: -4px;
    right: 0;
    width: 8px;
    height: 8px;
    border-top: 1px solid var(--color-text);
    border-right: 1px solid var(--color-text);
    transform: rotate(45deg);
  }

  .collector-page__timeline-point {
    position: absolute;
    top: 0;
    z-index: 1;
    color: var(--color-text);
    text-align: center;
    transform: translateX(-50%);
  }

  .collector-page__timeline-point span {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    font-style: normal;
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .collector-page__timeline-point i {
    display: block;
    width: 7px;
    height: 7px;
    margin: 12px auto 0;
    background: var(--color-background);
    border: 1px solid var(--color-text);
    border-radius: 50%;
  }

  .collector-page__timeline-point--year {
    left: 0;
    text-align: left;
    transform: none;
  }

  .collector-page__timeline-point--year i {
    margin-right: 0;
    margin-left: 0;
  }

  .collector-page__timeline-point--1 {
    left: 20%;
  }

  .collector-page__timeline-point--2 {
    left: 40%;
  }

  .collector-page__timeline-point--3 {
    left: 60%;
  }

  .collector-page__timeline-point--4 {
    left: 80%;
  }

  .collector-page__timeline-point--5 {
    left: calc(100% - 14px);
  }

  .collector-page__final {
    position: relative;
    min-height: 260px;
    color: #fff;
  }

  .collector-page__final-copy {
    position: absolute;
    z-index: 1;
    left: var(--collector-content-gutter);
    bottom: clamp(28px, 5vw, 62px);
    max-width: 460px;
  }

  .collector-page__final::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0.1));
  }

  .collector-product-card__media .collector-page__image-placeholder,
  .collector-page__archive-media .collector-page__image-placeholder {
    height: 100%;
    min-height: 0;
  }

  @media screen and (max-width: 60em) {
    .collector-page__hero,
    .collector-page__story,
    .collector-page__info-grid {
      grid-template-columns: 1fr;
    }

    .collector-page__hero-copy,
    .collector-page__story-copy,
    .collector-page__rules,
    .collector-page__perspective {
      padding: 36px 24px;
    }

    .collector-page__hero h1 {
      max-width: 360px;
      font-size: 36px;
    }

    .collector-page__hero {
      min-height: 0;
    }

    .collector-page__hero-media {
      min-height: 260px;
      aspect-ratio: 1.35 / 1;
    }

    .collector-page__story-media {
      min-height: 320px;
    }

    .collector-page__products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--spacing-medium);
      row-gap: var(--spacing-large);
    }

    .collector-page__story-copy {
      min-height: 0;
    }

    .collector-page__rules {
      border-right: 0;
    }

    .collector-page__info-grid::after {
      display: none;
    }

    .collector-page__rules::after {
      content: "";
      position: absolute;
      right: 24px;
      bottom: 0;
      left: 24px;
      height: 1px;
      background: var(--color-border);
    }

    .collector-page__rules,
    .collector-page__perspective {
      min-height: 0;
    }

    .collector-page__archive-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
  }

  @media screen and (max-width: 38em) {
    .collector-page__hero h1 {
      font-size: 36px;
    }

    .collector-page__archive-grid {
      grid-template-columns: 1fr;
    }

    .collector-page__release {
      padding-right: 24px;
      padding-left: 24px;
    }
  }
</style>

<script>
  (() => {
    const section = document.querySelector(
      '[data-section-id="{{ section.id }}"][data-section-type="collector-edition"]'
    );
    const trigger = section?.querySelector('[data-collector-scroll]');
    const target = section?.querySelector('#collector-story');

    if (!trigger || !target) return;

    trigger.addEventListener('click', (event) => {
      event.preventDefault();

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      target.scrollIntoView({
        behavior: reduceMotion ? 'auto' : 'smooth',
        block: 'start'
      });
    });
  })();
</script>

