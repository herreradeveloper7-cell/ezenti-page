{%- liquid
  assign collector_collection = section.settings.collection
  assign max_products = section.settings.max_products
-%}

<section
  class="collector-page"
  data-section-id="{{ section.id }}"
  data-section-type="collector-edition"
>
  <div class="collector-page__hero">
    <div class="collector-page__hero-copy">
      <p class="collector-page__eyebrow">{{ section.settings.hero_eyebrow }}</p>
      <h1>{{ section.settings.hero_heading | newline_to_br }}</h1>

      {%- if section.settings.hero_button_text != blank -%}
        <a class="collector-page__hero-button" href="{{ section.settings.hero_button_url }}">
          {{ section.settings.hero_button_text }}
        </a>
      {%- endif -%}

      {%- if section.settings.hero_link_text != blank -%}
        <a class="collector-page__hero-scroll" href="{{ section.settings.hero_link_url }}">
          {{ section.settings.hero_link_text }}
          <span aria-hidden="true"></span>
        </a>
      {%- endif -%}
    </div>

    <div class="collector-page__hero-media">
      {%- if section.settings.hero_image != blank -%}
        <img
          src="{{ section.settings.hero_image | image_url: width: 1400 }}"
          alt="{{ section.settings.hero_image.alt | escape }}"
          width="{{ section.settings.hero_image.width }}"
          height="{{ section.settings.hero_image.height }}"
          loading="eager"
        >
      {%- else -%}
        <div class="collector-page__image-placeholder">
          Hero image
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="collector-page__release" id="collector-current-release">
    <div class="collector-page__release-header">
      <h2>{{ section.settings.products_heading }}</h2>
      <p>{{ section.settings.release_label }}</p>
    </div>

    <div class="collector-page__products">
        {%- if collector_collection != blank and collector_collection.products_count > 0 -%}
          {%- for product in collector_collection.products limit: max_products -%}
            <article class="collector-product-card">
              <a class="collector-product-card__media" href="{{ product.url | within: collector_collection }}" aria-label="{{ product.title }}">
                {%- if product.featured_media != blank -%}
                  <img
                    src="{{ product.featured_media.preview_image | image_url: width: 700 }}"
                    alt="{{ product.featured_media.alt | default: product.title | escape }}"
                    width="{{ product.featured_media.preview_image.width }}"
                    height="{{ product.featured_media.preview_image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="collector-page__image-placeholder">Product image</div>
                {%- endif -%}
              </a>

              <div class="collector-product-card__meta">
                <h3>
                  <a href="{{ product.url | within: collector_collection }}">{{ product.title }}</a>
                </h3>
                <p>{{ product.price | money }}</p>

                {%- assign size_option = blank -%}
                {%- for option in product.options_with_values -%}
                  {%- assign option_name = option.name | downcase -%}
                  {%- if option_name contains 'size' or option_name contains 'talla' -%}
                    {%- assign size_option = option -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if size_option != blank -%}
                  <ul class="collector-product-card__sizes" aria-label="Available sizes">
                    {%- for value in size_option.values -%}
                      <li>{{ value }}</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <article class="collector-product-card">
              <div class="collector-product-card__media">
                <div class="collector-page__image-placeholder">Collector product</div>
              </div>
              <div class="collector-product-card__meta">
                <h3>Collector piece</h3>
                <p>$00.00</p>
                <ul class="collector-product-card__sizes"><li>S</li><li>M</li><li>L</li><li>XL</li></ul>
              </div>
            </article>
          {%- endfor -%}
        {%- endif -%}
    </div>
  </div>

  <div class="collector-page__cta">
    <p>{{ section.settings.cta_eyebrow }}</p>
    <h2>{{ section.settings.cta_heading }}</h2>
    <span class="collector-page__down-icon" aria-hidden="true"></span>
  </div>

  <div class="collector-page__story" id="collector-story">
    <div class="collector-page__story-copy">
      <h2>{{ section.settings.story_heading | newline_to_br }}</h2>
      <div class="collector-page__rte">{{ section.settings.story_text }}</div>
      {%- if section.settings.story_link_text != blank -%}
        <a class="collector-page__underline-link" href="{{ section.settings.story_link_url }}">{{ section.settings.story_link_text }}</a>
      {%- endif -%}
    </div>

    <div class="collector-page__story-media">
      {%- if section.settings.story_image != blank -%}
        <img
          src="{{ section.settings.story_image | image_url: width: 1400 }}"
          alt="{{ section.settings.story_image.alt | escape }}"
          width="{{ section.settings.story_image.width }}"
          height="{{ section.settings.story_image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="collector-page__image-placeholder">
          Story image
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="collector-page__process">
    <h2>{{ section.settings.process_heading }}</h2>

    <div class="collector-page__process-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'process_step' -%}
          <figure class="collector-page__process-step" {{ block.shopify_attributes }}>
            <div class="collector-page__process-media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="collector-page__image-placeholder">Process image</div>
              {%- endif -%}
            </div>

            <figcaption>{{ block.settings.title }}</figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="collector-page__info-grid">
    <div class="collector-page__rules">
      <h2>{{ section.settings.rules_heading }}</h2>
      <ol>
        {%- assign rule_number = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'rule' -%}
            {%- assign rule_number = rule_number | plus: 1 -%}
            <li {{ block.shopify_attributes }}>
              <span>{{ rule_number | prepend: '0' | slice: -2, 2 }}</span>
              <p>{{ block.settings.text }}</p>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
      {%- if section.settings.rules_link_text != blank -%}
        <a class="collector-page__underline-link" href="{{ section.settings.rules_link_url }}">{{ section.settings.rules_link_text }}</a>
      {%- endif -%}
    </div>

    <div class="collector-page__info-media">
      {%- if section.settings.info_image != blank -%}
        <img
          src="{{ section.settings.info_image | image_url: width: 1000 }}"
          alt="{{ section.settings.info_image.alt | default: section.settings.rules_heading | escape }}"
          width="{{ section.settings.info_image.width }}"
          height="{{ section.settings.info_image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="collector-page__image-placeholder">Rules image</div>
      {%- endif -%}
    </div>

    <div class="collector-page__included">
      <h2>{{ section.settings.included_heading }}</h2>

      <div class="collector-page__included-list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'included_item' -%}
            <article class="collector-page__included-item" {{ block.shopify_attributes }}>
              <div class="collector-page__included-media">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 300 }}"
                    alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="collector-page__image-placeholder">Item image</div>
                {%- endif -%}
              </div>

              <div class="collector-page__included-copy">
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="collector-page__archive">
    <h2>{{ section.settings.archive_heading }}</h2>
    <div class="collector-page__archive-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'archive_piece' -%}
          <article class="collector-page__archive-card" {{ block.shopify_attributes }}>
            <div class="collector-page__archive-media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 700 }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="collector-page__image-placeholder">Archive image</div>
              {%- endif -%}
            </div>
            <p>{{ block.settings.number }}</p>
            <h3>{{ block.settings.title }}</h3>
            <span>{{ block.settings.status }}</span>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="collector-page__timeline" aria-label="{{ section.settings.timeline_year }} Collector Edition timeline">
      <div class="collector-page__timeline-inner">
        <div class="collector-page__timeline-line" aria-hidden="true"></div>

        <div class="collector-page__timeline-point collector-page__timeline-point--year">
          <span>{{ section.settings.timeline_year }}</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="collector-page__timeline-point collector-page__timeline-point--1">
          <span>{{ section.settings.timeline_point_1 }}</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="collector-page__timeline-point collector-page__timeline-point--2">
          <span>{{ section.settings.timeline_point_2 }}</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="collector-page__timeline-point collector-page__timeline-point--3">
          <span>{{ section.settings.timeline_point_3 }}</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="collector-page__timeline-point collector-page__timeline-point--4">
          <span>{{ section.settings.timeline_point_4 }}</span>
          <i aria-hidden="true"></i>
        </div>
        <div class="collector-page__timeline-point collector-page__timeline-point--5">
          <span>{{ section.settings.timeline_point_5 }}</span>
          <i aria-hidden="true"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="collector-page__final">
    <div class="collector-page__final-copy">
      <h2>{{ section.settings.final_heading | newline_to_br }}</h2>
      {%- if section.settings.final_link_text != blank -%}
        <a class="collector-page__text-link collector-page__text-link--light" href="{{ section.settings.final_link_url }}">
          {{ section.settings.final_link_text }}
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.final_image != blank -%}
      <img
        src="{{ section.settings.final_image | image_url: width: 1400 }}"
        alt="{{ section.settings.final_image.alt | escape }}"
        width="{{ section.settings.final_image.width }}"
        height="{{ section.settings.final_image.height }}"
        loading="lazy"
      >
    {%- else -%}
      <div class="collector-page__image-placeholder">Final image</div>
    {%- endif -%}
  </div>
</section>

<style>
  .collector-page {
    --collector-content-gutter: max(
      var(--space-outer),
      calc((100vw - var(--max-width)) / 2 + var(--space-outer))
    );

    color: var(--color-text);
    background: var(--color-background);
  }

  .collector-page a {
    color: inherit;
  }

  .collector-page__hero,
  .collector-page__story,
  .collector-page__info-grid {
    display: grid;
    grid-template-columns: 0.82fr 1fr;
  }

  .collector-page__hero {
    min-height: 390px;
    border-bottom: 1px solid var(--color-border);
  }

  .collector-page__hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(40px, 5vw, 64px) clamp(24px, 4vw, 60px);
    padding-left: var(--collector-content-gutter);
  }

  .collector-page__story-copy,
  .collector-page__rules {
    padding: clamp(42px, 7vw, 86px) clamp(24px, 4vw, 60px);
    padding-left: var(--collector-content-gutter);
  }

  .collector-page__included {
    padding: clamp(42px, 7vw, 86px) clamp(24px, 4vw, 60px);
    padding-right: var(--collector-content-gutter);
  }

  .collector-page__eyebrow,
  .collector-page__release-header p,
  .collector-page__cta p,
  .collector-page__archive-card p,
  .collector-page__archive-card span,
  .collector-product-card__sizes,
  .collector-page__text-link,
  .collector-page__underline-link {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .collector-page__hero h1 {
    max-width: 480px;
    margin: 14px 0 24px;
    font-family: var(--font-heading);
    font-size: clamp(34px, 4vw, 56px);
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .collector-page__hero-button {
    display: inline-flex;
    width: max-content;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0 28px;
    margin-bottom: 22px;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    background: #000;
    border: 1px solid #000;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .collector-page__hero-button:hover,
  .collector-page__hero-button:focus-visible {
    color: #000;
    background: transparent;
  }

  .collector-page__hero-scroll {
    display: inline-flex;
    width: max-content;
    align-items: center;
    gap: 24px;
    color: var(--color-text);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .collector-page__hero-scroll span {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
  }

  .collector-page__hero-media {
    min-height: 390px;
    aspect-ratio: 1.55 / 1;
    background: #111;
    overflow: hidden;
  }

  .collector-page__story-media,
  .collector-page__final {
    min-height: 420px;
    background: #111;
    overflow: hidden;
  }

  .collector-page__hero-media img,
  .collector-page__story-media img,
  .collector-page__final img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collector-page__image-placeholder {
    display: flex;
    width: 100%;
    min-height: inherit;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: linear-gradient(135deg, #1b1b1b, #3f3f3f);
  }

  .collector-page__text-link {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    text-decoration: none;
  }

  .collector-page__text-link span,
  .collector-page__down-icon {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
  }

  .collector-page__release {
    padding: 28px var(--collector-content-gutter) 44px;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .collector-page__release-header {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
  }

  .collector-page h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(24px, 2.2vw, 34px);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0;
  }

  .collector-page__products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: var(--spacing-large);
    row-gap: var(--spacing-extra-large);
  }

  .collector-product-card {
    min-width: 0;
  }

  .collector-product-card__media {
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--color-card-background);
    overflow: hidden;
  }

  .collector-product-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collector-product-card__meta {
    padding-top: var(--spacing-medium);
    text-align: left;
  }

  .collector-product-card__meta h3,
  .collector-product-card__meta p {
    margin: 0 0 var(--spacing-extra-small);
    font-size: 12px;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .collector-product-card__meta h3 {
    font-family: var(--font-heading);
    font-weight: var(--font-heading-weight);
  }

  .collector-product-card__meta p {
    font-weight: var(--font-body-bold-weight);
  }

  .collector-product-card__sizes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-medium);
    padding: 0;
    margin: var(--spacing-small) 0 0;
    list-style: none;
  }

  .collector-page__cta {
    padding: 28px 24px;
    color: #fff;
    text-align: center;
    background: #111;
  }

  .collector-page__cta h2 {
    margin-top: 8px;
    font-size: clamp(24px, 2.6vw, 38px);
    letter-spacing: 0.08em;
  }

  .collector-page__down-icon {
    margin-top: 16px;
  }

  .collector-page__story {
    grid-template-columns: 0.56fr 1fr;
    border-bottom: 1px solid var(--color-border);
  }

  .collector-page__story-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .collector-page__process {
    padding: var(--spacing-extra-large) var(--collector-content-gutter);
    border-bottom: 1px solid var(--color-border);
  }

  .collector-page__process h2 {
    margin-bottom: var(--spacing-large);
    font-size: 24px;
  }

  .collector-page__process-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: var(--spacing-medium);
    row-gap: var(--spacing-large);
  }

  .collector-page__process-step {
    min-width: 0;
    margin: 0;
  }

  .collector-page__process-media {
    aspect-ratio: 1.45 / 1;
    background: var(--color-card-background);
    overflow: hidden;
  }

  .collector-page__process-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collector-page__process-media .collector-page__image-placeholder {
    height: 100%;
    min-height: 0;
  }

  .collector-page__process-step figcaption {
    margin-top: var(--spacing-small);
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: var(--font-heading-weight);
    line-height: 1.3;
    text-transform: uppercase;
  }

  .collector-page__rte {
    max-width: 320px;
    margin-top: 28px;
    font-size: 14px;
    line-height: 1.55;
  }

  .collector-page__underline-link {
    display: inline-block;
    width: max-content;
    margin-top: 28px;
    padding-bottom: 4px;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  .collector-page__info-grid {
    grid-template-columns: 0.86fr 0.78fr 1fr;
    border-bottom: 1px solid var(--color-border);
  }

  .collector-page__rules {
    border-right: 1px solid var(--color-border);
  }

  .collector-page__rules ol {
    padding: 0;
    margin: 32px 0 0;
    list-style: none;
  }

  .collector-page__rules li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    margin-bottom: 22px;
  }

  .collector-page__rules li span,
  .collector-page__rules li p {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .collector-page__info-media {
    min-height: 520px;
    background: var(--color-card-background);
    border-right: 1px solid var(--color-border);
    overflow: hidden;
  }

  .collector-page__info-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collector-page__info-media .collector-page__image-placeholder {
    height: 100%;
  }

  .collector-page__included {
    border-left: 0;
  }

  .collector-page__included-list {
    display: grid;
    gap: var(--spacing-medium);
    margin-top: var(--spacing-large);
  }

  .collector-page__included-item {
    display: grid;
    grid-template-columns: minmax(70px, 92px) minmax(0, 1fr);
    align-items: center;
    gap: var(--spacing-medium);
  }

  .collector-page__included-media {
    aspect-ratio: 1.45 / 1;
    background: var(--color-card-background);
    overflow: hidden;
  }

  .collector-page__included-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collector-page__included-media .collector-page__image-placeholder {
    height: 100%;
    min-height: 0;
    padding: var(--spacing-extra-small);
    font-size: 9px;
  }

  .collector-page__included-copy h3,
  .collector-page__included-copy p {
    margin: 0;
    line-height: 1.25;
  }

  .collector-page__included-copy h3 {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: var(--font-heading-weight);
    text-transform: uppercase;
  }

  .collector-page__included-copy p {
    margin-top: 3px;
    font-size: 12px;
  }

  .collector-page__archive {
    padding: 30px var(--collector-content-gutter) 42px;
    border-bottom: 1px solid var(--color-border);
  }

  .collector-page__archive-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
    margin-top: 22px;
  }

  .collector-page__archive-media {
    aspect-ratio: 2.4 / 1;
    background: #222;
    overflow: hidden;
  }

  .collector-page__archive-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collector-page__archive-card h3 {
    margin: 4px 0;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .collector-page__timeline {
    width: 100%;
    margin-top: var(--spacing-extra-large);
    padding: 0 8px var(--spacing-small);
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .collector-page__timeline-inner {
    position: relative;
    min-width: 760px;
    height: 58px;
  }

  .collector-page__timeline-line {
    position: absolute;
    top: 37px;
    right: 0;
    left: 0;
    height: 1px;
    background: var(--color-border);
  }

  .collector-page__timeline-line::after {
    content: "";
    position: absolute;
    top: -4px;
    right: 0;
    width: 8px;
    height: 8px;
    border-top: 1px solid var(--color-text);
    border-right: 1px solid var(--color-text);
    transform: rotate(45deg);
  }

  .collector-page__timeline-point {
    position: absolute;
    top: 0;
    z-index: 1;
    color: var(--color-text);
    text-align: center;
    transform: translateX(-50%);
  }

  .collector-page__timeline-point span {
    display: block;
    font-size: 11px;
    font-weight: var(--font-body-bold-weight);
    line-height: 1.2;
    text-transform: uppercase;
  }

  .collector-page__timeline-point i {
    display: block;
    width: 7px;
    height: 7px;
    margin: 12px auto 0;
    background: var(--color-background);
    border: 1px solid var(--color-text);
    border-radius: 50%;
  }

  .collector-page__timeline-point--year {
    left: 0;
    text-align: left;
    transform: none;
  }

  .collector-page__timeline-point--year i {
    margin-right: 0;
    margin-left: 0;
  }

  .collector-page__timeline-point--1 {
    left: 20%;
  }

  .collector-page__timeline-point--2 {
    left: 40%;
  }

  .collector-page__timeline-point--3 {
    left: 60%;
  }

  .collector-page__timeline-point--4 {
    left: 80%;
  }

  .collector-page__timeline-point--5 {
    left: calc(100% - 14px);
  }

  .collector-page__final {
    position: relative;
    min-height: 260px;
    color: #fff;
  }

  .collector-page__final-copy {
    position: absolute;
    z-index: 1;
    left: var(--collector-content-gutter);
    bottom: clamp(28px, 5vw, 62px);
    max-width: 460px;
  }

  .collector-page__final::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0.1));
  }

  .collector-product-card__media .collector-page__image-placeholder,
  .collector-page__archive-media .collector-page__image-placeholder {
    height: 100%;
    min-height: 0;
  }

  @media screen and (max-width: 60em) {
    .collector-page__hero,
    .collector-page__story,
    .collector-page__info-grid {
      grid-template-columns: 1fr;
    }

    .collector-page__hero-copy,
    .collector-page__story-copy,
    .collector-page__rules,
    .collector-page__included {
      padding: 36px 24px;
    }

    .collector-page__hero h1 {
      max-width: 360px;
      margin-bottom: 28px;
      font-size: 36px;
    }

    .collector-page__hero {
      min-height: 0;
    }

    .collector-page__hero-media {
      min-height: 260px;
      aspect-ratio: 1.45 / 1;
    }

    .collector-page__story-media {
      min-height: 320px;
    }

    .collector-page__release-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .collector-page__products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--spacing-medium);
      row-gap: var(--spacing-large);
    }

    .collector-page__process-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .collector-page__story {
      display: flex;
      flex-direction: column;
    }

    .collector-page__story-media {
      order: -1;
    }

    .collector-page__rules {
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .collector-page__info-media {
      min-height: 420px;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .collector-page__archive-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
  }

  @media screen and (max-width: 38em) {
    .collector-page__hero h1 {
      font-size: 36px;
    }

    .collector-page__archive-grid {
      grid-template-columns: 1fr;
    }

    .collector-page__process {
      padding: var(--spacing-large) 24px;
    }

    .collector-page__process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

