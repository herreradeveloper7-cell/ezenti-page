{%- liquid
  assign about_heading_font = settings.font_heading | font_modify: 'weight', 'bold'
-%}

<section
  class="about-collections"
  data-section-id="{{ section.id }}"
  data-section-type="about-us-collections"
>
  <div class="about-collections__inner">
    {%- for block in section.blocks -%}
      <article
        class="about-collections__card"
        style="
          --card-text-color: {{ block.settings.text_color }};
          --card-overlay-color: {{ block.settings.overlay_color | color_modify: 'alpha', 0.76 }};
        "
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 1500 }}"
            srcset="
              {{ block.settings.image | image_url: width: 600 }} 600w,
              {{ block.settings.image | image_url: width: 1000 }} 1000w,
              {{ block.settings.image | image_url: width: 1500 }} 1500w
            "
            sizes="100vw"
            alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          <div class="about-collections__placeholder">Collection image</div>
        {%- endif -%}

        <div class="about-collections__shade" aria-hidden="true"></div>

        <div class="about-collections__content">
          {%- if block.settings.heading != blank -%}
            <h2>{{ block.settings.heading }}</h2>
          {%- endif -%}

          {%- if block.settings.subheading != blank -%}
            <p class="about-collections__subheading">{{ block.settings.subheading }}</p>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="about-collections__text rte">
              {{ block.settings.text }}
            </div>
          {%- endif -%}

          {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
            <a class="about-collections__link" href="{{ block.settings.link_url }}">
              {{ block.settings.link_label }}
              <span aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

<style>
  {{ about_heading_font | font_face: font_display: 'swap' }}

  .about-collections {
    background: var(--color-background);
  }

  .about-collections__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    box-sizing: border-box;
  }

  .about-collections__card {
    position: relative;
    min-width: 0;
    min-height: clamp(340px, 32vw, 460px);
    overflow: hidden;
    color: var(--card-text-color);
    background: var(--color-card-background);
  }

  .about-collections__card img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-collections__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--card-text-color);
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: var(--font-body-weight);
    text-transform: uppercase;
    opacity: 0.55;
  }

  .about-collections__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--card-overlay-color) 0%,
      var(--card-overlay-color) 28%,
      transparent 78%
    );
    pointer-events: none;
  }

  .about-collections__content {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    min-height: inherit;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-top: clamp(32px, 4vw, 60px);
    padding-bottom: clamp(32px, 4vw, 60px);
    box-sizing: border-box;
    text-align: left;
    filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.2));
  }

  .about-collections__card:first-child .about-collections__content {
    padding-right: max(
      var(--space-outer),
      calc((100vw - var(--max-width)) / 2 + var(--space-outer))
    );
    padding-left: var(--space-outer);
    align-items: flex-end;
    text-align: right;
  }

  .about-collections__card:last-child .about-collections__content {
    padding-right: var(--space-outer);
    padding-left: max(
      var(--space-outer),
      calc((100vw - var(--max-width)) / 2 + var(--space-outer))
    );
    align-items: flex-start;
    text-align: left;
  }

  .about-collections__card:first-child .about-collections__shade {
    background: linear-gradient(
      270deg,
      var(--card-overlay-color) 0%,
      var(--card-overlay-color) 28%,
      transparent 78%
    );
  }

  .about-collections__card:first-child .about-collections__text,
  .about-collections__card:first-child .about-collections__link {
    text-align: right;
  }

  .about-collections__content h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(32px, 3.1vw, 48px);
    font-style: normal;
    font-weight: {{ about_heading_font.weight | default: 700 }};
    line-height: 0.92;
    letter-spacing: var(--font-heading-base-letter-spacing);
    text-transform: uppercase;
  }

  .about-collections__subheading {
    margin: var(--spacing-small) 0 0;
    font-family: var(--font-heading);
    font-size: clamp(20px, 1.7vw, 27px);
    font-style: normal;
    font-weight: {{ about_heading_font.weight | default: 700 }};
    line-height: 1;
    letter-spacing: var(--font-heading-base-letter-spacing);
    text-transform: uppercase;
  }

  .about-collections__text {
    max-width: 440px;
    margin-top: var(--spacing-large);
    font-family: var(--font-body);
    font-size: 15px;
    font-style: normal;
    font-weight: var(--font-body-weight);
    line-height: 1.3;
  }

  .about-collections__text p {
    margin: 0;
  }

  .about-collections__text p + p {
    margin-top: var(--spacing-medium);
  }

  .about-collections__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: var(--spacing-large);
    color: currentColor;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
  }

  .about-collections__link::after {
    position: absolute;
    right: 0;
    bottom: -5px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms ease;
  }

  .about-collections__link {
    position: relative;
  }

  .about-collections__link:hover::after,
  .about-collections__link:focus-visible::after {
    transform: scaleX(1);
  }

  @media screen and (max-width: 64em) {
    .about-collections__card {
      min-height: 420px;
    }

    .about-collections__content {
      padding-top: var(--spacing-extra-large);
      padding-bottom: var(--spacing-extra-large);
    }
  }

  @media screen and (max-width: 48em) {
    .about-collections__card {
      min-height: 380px;
    }

    .about-collections__shade {
      background: linear-gradient(
        90deg,
        var(--card-overlay-color) 0%,
        var(--card-overlay-color) 35%,
        transparent 90%
      );
    }

    .about-collections__card:first-child .about-collections__shade {
      background: linear-gradient(
        270deg,
        var(--card-overlay-color) 0%,
        var(--card-overlay-color) 35%,
        transparent 90%
      );
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .about-collections__link::after {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "About Us collections",
  "max_blocks": 2,
  "settings": [],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection panel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The Core Collections"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Built to evolve."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add the collection description here.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#111111"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Text shadow color",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us collections",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
