{%- liquid
  assign about_heading_font = settings.font_heading | font_modify: 'weight', 'bold'
-%}

<section
  class="about-principles"
  data-section-id="{{ section.id }}"
  data-section-type="about-us-principles"
>
  <div class="about-principles__inner">
    <header class="about-principles__header">
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.heading_second_line != blank -%}
        <p>{{ section.settings.heading_second_line }}</p>
      {%- endif -%}
    </header>

    <div class="about-principles__grid">
      {%- for block in section.blocks -%}
        <article class="about-principles__item" {{ block.shopify_attributes }}>
          {%- if block.settings.letter != blank -%}
            <p class="about-principles__letter">{{ block.settings.letter }}</p>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3>{{ block.settings.heading }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="about-principles__text rte">
              {{ block.settings.text }}
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  {{ about_heading_font | font_face: font_display: 'swap' }}

  .about-principles {
    color: var(--color-text);
    background: var(--color-background);
  }

  .about-principles__inner {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(56px, 6vw, 92px) var(--space-outer);
    box-sizing: border-box;
  }

  .about-principles__header {
    max-width: 900px;
    margin: 0 auto clamp(48px, 5vw, 72px);
    text-align: center;
  }

  .about-principles__header h2,
  .about-principles__header p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(28px, 2.7vw, 40px);
    font-style: normal;
    font-weight: {{ about_heading_font.weight | default: 700 }};
    line-height: 0.98;
    letter-spacing: var(--font-heading-base-letter-spacing);
    text-transform: uppercase;
  }

  .about-principles__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .about-principles__item {
    min-width: 0;
    padding: 0 clamp(16px, 1.7vw, 28px);
    text-align: center;
  }

  .about-principles__item:first-child {
    padding-left: 0;
  }

  .about-principles__item:last-child {
    padding-right: 0;
  }

  .about-principles__item + .about-principles__item {
    border-left: 1px solid rgba(20, 20, 20, 0.28);
  }

  .about-principles__letter {
    min-height: 1em;
    margin: 0 0 var(--spacing-large);
    font-family: var(--font-heading);
    font-size: clamp(28px, 2.4vw, 38px);
    font-style: normal;
    font-weight: {{ about_heading_font.weight | default: 700 }};
    line-height: 1;
    text-transform: uppercase;
  }

  .about-principles__item h3 {
    margin: 0 0 var(--spacing-large);
    font-family: var(--font-heading);
    font-size: clamp(20px, 1.65vw, 26px);
    font-style: normal;
    font-weight: {{ about_heading_font.weight | default: 700 }};
    line-height: 1;
    letter-spacing: var(--font-heading-base-letter-spacing);
    text-transform: uppercase;
  }

  .about-principles__text {
    font-family: var(--font-body);
    font-size: 14px;
    font-style: normal;
    font-weight: var(--font-body-weight);
    line-height: 1.25;
  }

  .about-principles__text p {
    margin: 0;
  }

  .about-principles__text p + p {
    margin-top: 6px;
  }

  @media screen and (max-width: 68em) {
    .about-principles__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .about-principles__item {
      padding: var(--spacing-extra-large);
    }

    .about-principles__item:nth-child(3n + 1) {
      padding-left: 0;
      border-left: 0;
    }

    .about-principles__item:nth-child(3n) {
      padding-right: 0;
    }

    .about-principles__item:nth-child(n + 4) {
      border-top: 1px solid rgba(20, 20, 20, 0.28);
    }
  }

  @media screen and (max-width: 42em) {
    .about-principles__header {
      margin-bottom: var(--spacing-extra-large);
    }

    .about-principles__header h2,
    .about-principles__header p {
      font-size: 28px;
    }

    .about-principles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-principles__item,
    .about-principles__item:nth-child(3n + 1),
    .about-principles__item:nth-child(3n) {
      padding: var(--spacing-extra-large) var(--spacing-medium);
    }

    .about-principles__item:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .about-principles__item:nth-child(even) {
      padding-right: 0;
      border-left: 1px solid rgba(20, 20, 20, 0.28);
    }

    .about-principles__item:nth-child(n + 3) {
      border-top: 1px solid rgba(20, 20, 20, 0.28);
    }

    .about-principles__letter {
      margin-bottom: var(--spacing-medium);
      font-size: 30px;
    }

    .about-principles__item h3 {
      margin-bottom: var(--spacing-medium);
      font-size: 21px;
    }
  }
</style>

