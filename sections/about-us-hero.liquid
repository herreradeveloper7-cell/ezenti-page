{%- liquid
  assign about_heading_font = settings.font_heading | font_modify: 'weight', 'bold'
-%}

<section
  class="about-us-page"
  data-section-id="{{ section.id }}"
  data-section-type="about-us-hero"
>
  <div class="about-us-page__inner">
    <div class="about-us-page__copy">
      <h1>{{ section.settings.heading }}</h1>

      {%- if section.settings.text != blank -%}
        <div class="about-us-page__text rte">
          {{ section.settings.text }}
        </div>
      {%- endif -%}
    </div>

    <div class="about-us-page__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1400 }}"
          srcset="
            {{ section.settings.image | image_url: width: 600 }} 600w,
            {{ section.settings.image | image_url: width: 900 }} 900w,
            {{ section.settings.image | image_url: width: 1400 }} 1400w
          "
          sizes="(min-width: 60em) 50vw, 100vw"
          alt="{{ section.settings.image.alt | default: page.title | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <div class="about-us-page__placeholder">About Us image</div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  {{ about_heading_font | font_face: font_display: 'swap' }}

  .about-us-page {
    color: var(--color-text);
    background: var(--color-background);
  }

  .about-us-page__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    align-items: stretch;
    gap: clamp(36px, 5vw, 76px);
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: clamp(48px, 6vw, 88px) var(--space-outer);
    box-sizing: border-box;
  }

  .about-us-page__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .about-us-page__copy h1 {
    max-width: 560px;
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(32px, 3.1vw, 48px);
    font-style: normal;
    font-weight: {{ about_heading_font.weight | default: 700 }};
    line-height: 1;
    letter-spacing: var(--font-heading-base-letter-spacing);
    text-transform: none;
  }

  .about-us-page__text {
    max-width: 560px;
    margin-top: var(--spacing-large);
    font-family: var(--font-body);
    font-style: normal;
    font-weight: var(--font-body-weight);
    font-size: 16px;
    line-height: 1.35;
  }

  .about-us-page__text p {
    margin: 0;
  }

  .about-us-page__text p + p {
    margin-top: var(--spacing-medium);
  }

  .about-us-page__media {
    position: relative;
    min-height: 0;
    background: var(--color-card-background);
    overflow: hidden;
  }

  .about-us-page__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-us-page__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 0;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  @media screen and (max-width: 60em) {
    .about-us-page__inner {
      grid-template-columns: 1fr;
      gap: var(--spacing-extra-large);
      padding-top: var(--spacing-extra-large);
      padding-bottom: var(--spacing-extra-large);
    }

    .about-us-page__copy h1,
    .about-us-page__text {
      max-width: 680px;
    }

    .about-us-page__media {
      aspect-ratio: 4 / 3;
      min-height: 0;
    }
  }

  @media screen and (max-width: 38em) {
    .about-us-page__copy h1 {
      font-size: 32px;
    }

    .about-us-page__text {
      font-size: 15px;
    }

    .about-us-page__media,
    .about-us-page__placeholder {
      min-height: 280px;
    }
  }
</style>

{% schema %}
{
  "name": "About Us hero",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "EZENTI was created by two people who believed clothing could communicate something deeper than appearance."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We never set out to create fashion for the sake of fashion.</p><p>We set out to build something that reflected intention over attention, where every garment began with an idea before it became a product.</p><p>Every decision we make; from the concepts we explore to the fabrics we choose, is guided by that same belief.</p><p>Because what we wear should never speak louder than the person wearing it.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "About Us hero"
    }
  ]
}
{% endschema %}
