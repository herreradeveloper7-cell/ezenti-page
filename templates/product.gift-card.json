{
  "sections": {
    "main": {
      "type": "main-product--default",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "border": {
          "type": "border",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "show_labels": true,
            "variant_popup_option": "Size",
            "variant_popup_text": "Size guide",
            "variant_popup_page": "",
            "siblings_show_product_image": true,
            "siblings_option_name": "Color"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "disabled": true,
          "settings": {
            "show_labels": true
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false
          }
        },
        "description": {
          "type": "description",
          "settings": {
            "style": "paragraph"
          }
        },
        "payment_widget": {
          "type": "payment_widget",
          "settings": {
            "column": "left",
            "style": "closed",
            "icon": "payment",
            "title": "Payment",
            "show_payment_icons": true,
            "text": "<p>Your payment information is processed securely. We do not store credit card details nor have access to your credit card information.</p>"
          }
        },
        "security_widget": {
          "type": "security_widget",
          "settings": {
            "column": "left",
            "style": "closed",
            "icon": "security",
            "title": "Security",
            "text": "<p>This website is encrypted. We take your security very seriously. All transactions powered by Shopify.</p>"
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "border",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "payment_widget",
        "security_widget"
      ],
      "settings": {
        "show_breadcrumbs": false,
        "show_navigation_buttons": false,
        "enable_sticky_product_details": true,
        "purchase_bar_flow": "checkout",
        "enable_quick_purchase_bar": true,
        "show_share_buttons": true,
        "image_aspect_ratio": "natural",
        "gallery_style": "thumbnails",
        "mobile_gallery_style": "thumbnails",
        "thumbnail_columns": "5",
        "gallery_size": "medium",
        "enable_product_lightbox": true,
        "enable_video_looping": true,
        "enable_animation": true,
        "enable_gift_card_recipient": true
      }
    },
    "product-recommendations": {
      "type": "product-recommendations",
      "disabled": true,
      "settings": {
        "max_products": 6,
        "columns": 3,
        "title": "Recommended",
        "subheading": "<p>You might want to take a closer look.</p>",
        "text_max_width": 42,
        "aspect_ratio": "portrait",
        "enable_animation": true,
        "section_contrast": false,
        "section_padding": "section--vertical-padding-top-bottom",
        "padding_amount": "1.0"
      }
    }
  },
  "order": ["main", "product-recommendations"]
}
