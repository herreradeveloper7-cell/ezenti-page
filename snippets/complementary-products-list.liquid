{% liquid
  assign columns = block_settings.columns | times: 1

  if product_source == 'custom-product-list'
    assign product_count = block_settings.product_list.count
    assign product_list = block_settings.product_list
  elsif product_source == 'app-recommendations'
    assign product_count = recommendations.products_count
    assign product_list = recommendations.products
  endif

  if should_render_design_mode_placeholders
    assign product_count = max_products
  endif

  if block_settings.layout == 'slider'
    assign show_slider = true
  endif

  if product_count < max_products
    assign max_products = product_count
  endif

  if columns >= max_products
    assign hide_desktop_slider_nav = true
  endif
%}

{% capture complementary_prod_list %}
<div
  class="
    complementary-products__content-wrapper
    {% if show_slider %}
      complementary-products__content-wrapper--has-slider
    {% else %}
      complementary-products__content-wrapper--has-grid
    {% endif %}
  "
>
  <div
    class="
      complementary-products__content complementary-products__content--columns-{{ columns }}
      {% if show_slider %}
        complementary-products__content--has-slider
      {% else %}
        complementary-products__content--has-grid
      {% endif %}
    "
    data-slider
  >
    {% if should_render_design_mode_placeholders %}
      {%- for i in (1..max_products) -%}
        <div class="complementary-products__slide carousel__slide" data-slide>
          {% render 'product-item',
            product: blank,
            aspect_ratio: block_settings.aspect_ratio,
            placeholder: true,
            product_columns: columns
          %}
        </div>
      {%- endfor -%}
    {% else %}
      {%- for product_item in product_list limit: max_products -%}
        <div class="complementary-products__slide carousel__slide" data-slide>
          {% render 'product-item',
            product: product_item,
            aspect_ratio: block_settings.aspect_ratio,
            quick_view_is_beneath: true,
            product_columns: columns
          %}
        </div>
      {%- endfor -%}
    {% endif %}
  </div>
  <div class="carousel__slide--navigation" data-hide-desktop-slider-nav="{{ hide_desktop_slider_nav }}">
    {%- if show_slider -%}
      {% render 'carousel-navigation', columns: block_settings.columns %}
    {%- endif -%}
  </div>
</div>
{% endcapture %}

{% if product_source == 'app-recommendations' %}
  <div data-complementary-products-content>
    {{ complementary_prod_list }}
  </div>
{% else %}
  {{ complementary_prod_list }}
{% endif %}
