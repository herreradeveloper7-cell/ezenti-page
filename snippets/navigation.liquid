{%- liquid
  assign navigation_additional_label = additional_link_label | default: 'ABOUT US'
  assign navigation_additional_url = additional_link_url | default: '/pages/about-us?view=about-us'
-%}

<ul class="header__links-list">
  {% for link in menu %}
    {%- liquid
      assign navigation_link_url = link.url
      assign navigation_link_title = link.title | strip | downcase
      if navigation_link_title == 'ezenti series'
        assign navigation_link_url = '/collections/collector-edition?view=collector-edition'
      endif

      if link.links.size > 0
        assign has_children = true
      endif
    -%}

    <li
      {% if has_children %}
        data-submenu-parent
      {% endif %}
    >
      {%- if has_children -%}
        {%- liquid
          assign child_is_active = false
          for link in link.links
            if link.active
              assign child_is_active = true
              break
            elsif link.links.size > 0
              for link in link.links
                if link.active
                  assign child_is_active = true
                  break
                endif
              endfor
            endif
          endfor
        -%}

        <button
          type="button"
          class="navigation__submenu-trigger fs-navigation-base no-transition{% if child_is_active %} active{% endif %}"
          data-link
          data-parent
          aria-haspopup="true"
          aria-expanded="false"
        >
          {{ link.title }}
          <span class="header__links-icon">
            {% render 'icon', icon: 'chevron' %}
          </span>
        </button>

        {%- liquid
          if has_children
            render 'navigation-submenu', menu: link.links, depth: 1
          endif

          assign has_children = false
        -%}
      {%- else -%}
        <a
          href="{{ navigation_link_url }}"
          class="fs-navigation-base {% if link.active %}active{% endif %}"
          data-link
          {% if link.active %}
            aria-current="page"
          {% endif %}
        >
          {{ link.title }}
        </a>
      {%- endif -%}
    </li>
  {% endfor %}

  <li>
    <a
      href="{{ navigation_additional_url }}"
      class="fs-navigation-base{% if request.path == navigation_additional_url %} active{% endif %}"
      data-link
      {% if request.path == navigation_additional_url %}
        aria-current="page"
      {% endif %}
    >
      {{ navigation_additional_label }}
    </a>
  </li>
</ul>
